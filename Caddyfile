{
	# Port 80 on this droplet is used by another app's nginx, so we cannot
	# serve the ACME HTTP-01 challenge or an HTTP->HTTPS redirect there.
	# Caddy obtains a publicly-trusted Let's Encrypt certificate using the
	# TLS-ALPN-01 challenge on port 443 (which we own) instead.
	auto_https disable_redirects
}

# The site is addressed by a hostname, not a bare IP, for two reasons:
#   1. Browsers/curl do NOT send an SNI server-name when connecting to an
#      IP literal (the TLS spec forbids it), so Caddy cannot select a
#      certificate and the handshake fails with "internal error".
#   2. A resolvable hostname lets Caddy get a real trusted certificate.
# sslip.io is a free wildcard-DNS service: <ip-with-dashes>.sslip.io
# resolves to that IP with no registration. SITE_ADDRESS is set by
# deploy/bootstrap.sh to the sslip.io name for this droplet's IP.
{$SITE_ADDRESS:188-166-88-105.sslip.io} {
	reverse_proxy app:8501
}

# De Retailer Console staat BEWUST niet in deze Caddy: die zou hem op een
# publieke hostnaam zetten, terwijl toegang via het portaal loopt
# (privé-adres + firewall-regel voor de gateway + forward-auth). De console
# luistert intern op 8000 en wordt door de gateway bediend, niet hier.
#
# Let op als de gateway hem doorstuurt: de SPA gebruikt absolute /assets- en
# /api-paden, dus hij moet op een eigen host/root staan, niet onder een
# subpad. Uploads gaan als multipart naar POST /api/import (de UI noemt
# 200 MB), dus zet de body-limiet van de gateway daarop.
