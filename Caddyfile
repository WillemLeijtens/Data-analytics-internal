{
	auto_https disable_redirects
}

# Port 80 is intentionally NOT bound here: this droplet already runs an
# nginx instance on host port 80 for another app. Only 443 is used, which
# was free at deploy time.
#
# We use an explicitly pre-generated self-signed cert (see
# deploy/gen-cert.sh, run by bootstrap.sh) rather than Caddy's `tls
# internal`. Caddy's internal CA does not reliably mint a leaf certificate
# for a bare IP-address site, which left the TLS handshake failing with
# "internal error". Pointing `tls` at a cert/key file we control sidesteps
# that entirely. SITE_ADDRESS still names the site so Caddy binds/serves
# it correctly.
{$SITE_ADDRESS:188.166.88.105} {
	tls /certs/site.crt /certs/site.key
	reverse_proxy app:8501
}
