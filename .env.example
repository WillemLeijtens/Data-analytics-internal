STREAMLIT_APP_PASSWORD=change-me
# A resolvable hostname pointing at the droplet, NOT a bare IP (TLS needs an
# SNI hostname). deploy/bootstrap.sh fills this with a free sslip.io name of
# the form <ip-with-dashes>.sslip.io, which resolves to the droplet's IP and
# lets Caddy fetch a trusted Let's Encrypt certificate.
SITE_ADDRESS=change-me.sslip.io
