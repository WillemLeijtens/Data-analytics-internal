# Kopieer naar .env op de droplet. Alles heeft een werkende standaardwaarde;
# je hoeft alleen te zetten wat je wilt afwijken.

# --- Toegang ---------------------------------------------------------------
# 'gateway' (standaard): geen inlog in de app zelf, het portaal authenticeert
# via forward-auth. 'password': HTTP basic auth in de app, vereist dan ook
# CONSOLE_PASSWORD. Gateway-modus mag alleen bij een prive binding.
CONSOLE_AUTH=gateway
# Waar de console luistert. Standaard 127.0.0.1; zet dit op het prive-adres
# van de droplet als de gateway erbij moet — nooit op 0.0.0.0.
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8010
# Alleen nodig bij CONSOLE_AUTH=password.
CONSOLE_PASSWORD=
CONSOLE_USER=console

# --- Uploads ---------------------------------------------------------------
# Maximale uploadgrootte per bestand (MiB).
CONSOLE_MAX_UPLOAD_MB=200
# Maximale UITGEPAKTE grootte van een .xlsx (MiB) — een klein bestand kan
# uitpakken tot vele GB's ("decompressiebom"); daarboven wordt hij geweigerd.
CONSOLE_MAX_UNCOMPRESSED_MB=1500

# --- AI-contractanalyse ----------------------------------------------------
# Nodig om een PDF-contract te laten uitlezen (looptijd + condities). Kan ook
# rechtstreeks in de app gezet worden onder Instellingen; die waarde wint dan
# van deze. Zonder sleutel werkt de rest van de app gewoon door.
ANTHROPIC_API_KEY=
# Optioneel: ander model dan de standaard.
CONSOLE_CONTRACT_MODEL=

# --- Overig ----------------------------------------------------------------
# Hoeveel dagen back-ups bewaard blijven.
BACKUP_KEEP_DAYS=14
# Geheugenplafond voor de console-container.
CONSOLE_MEM_LIMIT=1g
