STREAMLIT_APP_PASSWORD=change-me
# --- Automatic import, option A (recommended): forwarding mailbox ----------
# An Outlook rule forwards the report mails to a dedicated mailbox; the app
# reads only that one and never touches your own. Must be a NON-Microsoft
# mailbox (Microsoft disabled IMAP-with-password): e.g. Gmail with an App
# Password, or a mailbox at your web host.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Automatic import, option B: direct access to your own mailbox ---------
# Application (client) ID of your Azure app registration (Graph, Mail.Read).
AZURE_CLIENT_ID=
# Your tenant ID, or "common" to accept both work and personal accounts.
AZURE_TENANT_ID=common
# A resolvable hostname pointing at the droplet, NOT a bare IP (TLS needs an
# SNI hostname). deploy/bootstrap.sh fills this with a free sslip.io name of
# the form <ip-with-dashes>.sslip.io, which resolves to the droplet's IP and
# lets Caddy fetch a trusted Let's Encrypt certificate.
SITE_ADDRESS=change-me.sslip.io
